{
  "name": "fantasy-pet-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke:list": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -List",
    "test:smoke": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick",
    "test:smoke:quick": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick",
    "test:smoke:headed": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick -Headed",
    "test:smoke:full": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile full",
    "test:smoke:core": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile core",
    "test:smoke:world": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick -Group world",
    "test:smoke:ui": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile ui",
    "test:smoke:mobile": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick -Group mobile",
    "test:smoke:combat": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick -Group combat",
    "test:smoke:quest": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile quick -Group quest",
    "test:smoke:landscape-grid": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_smoke.ps1 -Profile landscape",
    "task:done": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_done.ps1",
    "task:done:headed": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_done.ps1 -Headed -WithSmoke -SmokeProfile quick",
    "task:done:smoke": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_done.ps1 -WithSmoke -SmokeProfile quick",
    "task:done:full": "pwsh -ExecutionPolicy Bypass -File ./scripts/task_done.ps1 -WithSmoke -SmokeProfile full",
    "hooks:install": "pwsh -ExecutionPolicy Bypass -File ./scripts/install_git_hooks.ps1",
    "fusion:export-mdb": "pwsh -ExecutionPolicy Bypass -File ./scripts/export_fusion_mdb.ps1",
    "fusion:export-list": "python -X utf8 ./scripts/export_fusion_list_excel.py",
    "fusion:export-all": "npm run fusion:export-mdb && npm run fusion:export-list",
    "gamedb:build-runtime": "python -X utf8 ./scripts/gamedb/build_runtime.py",
    "gamedb:validate": "python -X utf8 ./scripts/gamedb/validate_relations.py",
    "gamedb:repair-audit": "python -X utf8 ./scripts/gamedb/repair_audit.py",
    "gamedb:check-legacy": "node ./scripts/gamedb/check_legacy_usage.mjs",
    "ci:guardrails": "node ./scripts/ci/guardrails.mjs",
    "gamedb:p0": "npm run gamedb:build-runtime && npm run gamedb:validate"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0",
    "@babylonjs/materials": "^8.0.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "mysql": "^2.18.1",
    "mysql2": "^3.18.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
